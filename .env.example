# ====================================================================
# GitSense Environment Configuration
# Copy this file to .env.local and fill in your keys:
# cp .env.example .env.local
# ====================================================================

# 1. [RECOMMENDED] Google Gemini API Key
# Enables dynamic AI code search explanations, semantic vector embeddings,
# and grounded multi-turn repository chat.
# Get free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. [RECOMMENDED] GitHub Personal Access Token
# Increases GitHub API rate limit from 60 requests/hr to 5,000 requests/hr.
# Prevents rate-limit errors when indexing medium or large repositories.
# Generate token at: https://github.com/settings/tokens (select "public_repo" scope)
GITHUB_TOKEN=your_github_personal_access_token_here

# 3. [OPTIONAL] GitHub OAuth App Credentials
# Only required if you want to use the 1-click "Connect GitHub" browser login button.
# Create OAuth App at: https://github.com/settings/developers
# - Homepage URL: http://localhost:3000
# - Authorization callback URL: http://localhost:3000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 4. [OPTIONAL] PostgreSQL + pgvector Database URL
# Only required if you want persistent relational vector storage across restarts.
# If omitted, GitSense automatically uses the high-performance in-memory vector store.
# Format: postgresql://<user>:<password>@localhost:5432/<dbname>
DATABASE_URL=

# 5. Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
